# Contrato de variables de entorno — catalogo-app (Variante C)
# Copiar a .env y ajustar valores. El archivo .env no se versiona (.gitignore).
# Compose interpola ${VAR} desde .env en la misma carpeta que docker-compose.yml.

# =============================================================================
# catalogo-db — MongoDB 7
# =============================================================================

# Usuario administrador creado al inicializar un volumen vacío.
# Solo se aplica en el primer arranque sobre catalogo-db-data vacío.
MONGO_INITDB_ROOT_USERNAME=catalogo_user

# Contraseña del usuario administrador. Cambiarla en un volumen ya inicializado
# no tiene efecto: MongoDB conserva las credenciales del primer arranque.
MONGO_INITDB_ROOT_PASSWORD=catalogo_pass

# =============================================================================
# catalogo-api — Python + FastAPI
# =============================================================================

# Host de MongoDB en la red Docker (nombre del servicio).
DB_HOST=catalogo-db

# Puerto de MongoDB.
DB_PORT=27017

# Nombre de la base de datos de la aplicación.
DB_NAME=catalogodb

# Usuario para conectarse a MongoDB (debe coincidir con MONGO_INITDB_ROOT_USERNAME).
DB_USER=catalogo_user

# Contraseña para conectarse a MongoDB (debe coincidir con MONGO_INITDB_ROOT_PASSWORD).
DB_PASSWORD=catalogo_pass

# Versión reportada en GET /health.
APP_VERSION=v1

# Prefijo bajo el que la API es visible detrás del proxy del frontend.
# Dejar vacío solo si se accede directo al puerto 8000 (depuración).
ROOT_PATH=/api

# Si true, sembra el catálogo demo al arrancar (idempotente por sku).
SEED_DEMO=true

# --- Alternativa a DB_HOST, DB_PORT, DB_NAME, DB_USER y DB_PASSWORD ---
# Si se define MONGO_URI, la API la usa en lugar de armar la cadena desde DB_*.
# Incluye la contraseña en texto plano; en Kubernetes (semana 7) debe ir completa
# en un Secret, nunca en un ConfigMap.
# MONGO_URI=mongodb://catalogo_user:catalogo_pass@catalogo-db:27017/catalogodb?authSource=admin

# =============================================================================
# catalogo-frontend — nginx (React + Vite compilado)
# =============================================================================

# Host del backend al que nginx reenvía /api/ (nombre del servicio en catalogo-net).
API_HOST=catalogo-api

# Puerto del backend.
API_PORT=8000
